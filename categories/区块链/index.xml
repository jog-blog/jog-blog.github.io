    <item>
      <title>公链技术升级：以太坊2.0的智能合约安全增强分析</title>
      <link>https://bmsg.top/posts/%E5%85%AC%E9%93%BE%E6%8A%80%E6%9C%AF%E5%8D%87%E7%BA%A7%E4%BB%A5%E5%A4%AA%E5%9D%8A20%E7%9A%84%E6%99%BA%E8%83%BD%E5%90%88%E7%BA%A6%E5%AE%89%E5%85%A8%E5%A2%9E%E5%BC%BA%E5%88%86%E6%9E%90_20260123_020000/</link>
