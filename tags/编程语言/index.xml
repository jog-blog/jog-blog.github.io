    <item>
      <title>编程语言进化：从主流框架到工具迭代的前沿趋势</title>
      <link>https://bmsg.top/posts/%E7%BC%96%E7%A8%8B%E8%AF%AD%E8%A8%80%E8%BF%9B%E5%8C%96%E4%BB%8E%E4%B8%BB%E6%B5%81%E6%A1%86%E6%9E%B6%E5%88%B0%E5%B7%A5%E5%85%B7%E8%BF%AD%E4%BB%A3%E7%9A%84%E5%89%8D%E6%B2%BF%E8%B6%8B%E5%8A%BF_20260123_215130/</link>
